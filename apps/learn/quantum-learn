#!/bin/sh
# Quantum Learn (khoá học VPS Linux, Quickshell). Nếu đã mở: đưa cửa sổ lên trên (không mở thêm).
#   quantum-learn              mở bài đang học dở
#   quantum-learn <id bài>     mở thẳng một bài (vd: lb1, c3b)
# Cần: quickshell, nodejs, và mã nguồn course-vps ($QUANTUM_LEARN_COURSE hoặc ~/Documents/tutor/course-vps).
TITLE="Quantum Learn"
APP="$(dirname "$(readlink -f "$0")")/shell.qml"
addr=$(hyprctl clients -j 2>/dev/null | python3 -I -c "
import json,sys
for c in json.load(sys.stdin):
    if c.get('title') == sys.argv[1] and c.get('class') == 'org.quickshell':
        print(c['address']); break" "$TITLE")
if [ -n "$addr" ]; then
    [ -n "$1" ] && qs -p "$APP" ipc call learn open "$1" >/dev/null 2>&1
    exec hyprctl eval "cael_activate('$addr')" >/dev/null
fi
QS_LEARN_OPEN="$1" exec setsid qs -p "$APP" -n -d >/dev/null 2>&1 </dev/null
