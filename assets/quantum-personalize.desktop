[Desktop Entry]
Name=Ajustes del Sistema
Name[vi]=Cài đặt hệ thống
Name[en]=System Settings
GenericName=Apariencia del escritorio
Comment=Apariencia, pantalla, sonido, red, Bluetooth y más
Exec=sh -c "qs -c caelestia ipc call shell personalize || qs -c quantum ipc call shell personalize"
Icon=quantum-personalize
Terminal=false
Type=Application
Categories=Settings;DesktopSettings;
Keywords=personalizar;tema;apariencia;estilo;barra;dock;color;fondo;escritorio;ventanas;
StartupWMClass=org.quickshell
